# ==============================================================================
# Revamp SaaS - Environment Configuration
# ==============================================================================

# Server / API Gateway
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
API_PREFIX=/api/v1

# MongoDB 7.0
MONGODB_URI=mongodb://localhost:27017/revamp

# Redis 7.0 (BullMQ & Token Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ASSETS=revamp-assets
S3_BUCKET_DEMOS=revamp-demos
S3_FORCE_PATH_STYLE=true
PREVIEW_DOMAIN=preview.revampdemo.com

# AI Models (Vision LLM & Copywriting)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Email Outreach (Resend / SendGrid)
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="Revamp Team <outreach@revampdemo.com>"

# Operator / HITL Settings
OPERATOR_NOTIFY_EMAIL=operator@revampdemo.com

# Frontend Dashboard
VITE_API_URL=http://localhost:4000/api/v1
