# ==============================================================================
# Revamp SaaS - Environment Configuration
# ==============================================================================

# Server / API Gateway
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
API_PREFIX=/api/v1

# MongoDB 7.0
MONGODB_URI=mongodb://localhost:27017/revamp

# Redis 7.0 (BullMQ & Token Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ASSETS=revamp-assets
S3_BUCKET_DEMOS=revamp-demos
S3_FORCE_PATH_STYLE=true
PREVIEW_DOMAIN=preview.revampdemo.com

# AI Models (Vision LLM & Copywriting)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# MVP copy provider: anthropic | openai | gemini | claude-cli | mock (empty = first API key found)
MVP_LLM_PROVIDER=
# claude-cli: runs the local Claude Code CLI headless with the account it is logged into
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT_MS=120000
# MVP completeness check (REV-37): the MVP_LLM_PROVIDER model judges the fields, with its quotes
# verified in code. false = code-only comparison. Falls back to code on timeout or error.
MVP_COMPLETENESS_LLM=true
MVP_COMPLETENESS_LLM_TIMEOUT_MS=90000

# Email Outreach (Resend / SendGrid)
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="Revamp Team <outreach@revampdemo.com>"

# Local Business Discovery (REV-26)
# OpenStreetMap works without a key; Google Places API (New) needs one
GOOGLE_PLACES_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
DISCOVERY_USER_AGENT="RevampBot/0.1 (+https://revampdemo.com)"

# Operator / HITL Settings
OPERATOR_NOTIFY_EMAIL=operator@revampdemo.com

# Frontend Dashboard
VITE_API_URL=http://localhost:4000/api/v1
