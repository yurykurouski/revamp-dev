# ==============================================================================
# Revamp SaaS - Environment Configuration
# ==============================================================================

# Server / API Gateway
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
API_PREFIX=/api/v1

# MongoDB 7.0
MONGODB_URI=mongodb://localhost:27017/revamp

# Redis 7.0 (BullMQ & Token Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ASSETS=revamp-assets
S3_BUCKET_DEMOS=revamp-demos
S3_FORCE_PATH_STYLE=true
PREVIEW_DOMAIN=preview.revampdemo.com
# Public API address. Generated MVPs load revamp-tracker.js and send telemetry here, and emails
# use it for the open pixel and unsubscribe links. MVPs store it when generated: regenerate after changing it.
PUBLIC_API_URL=http://localhost:4000/api/v1

# AI Models (Vision LLM & Copywriting)
# The design critique needs ANTHROPIC_API_KEY, OPENAI_API_KEY or the local Claude Code CLI; without one, audits fail with a clear error
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# MVP copy provider: anthropic | openai | gemini | claude-cli (empty = first API key found).
# With none, MVP generation fails unless the operator picks a provider in the dashboard.
MVP_LLM_PROVIDER=
# claude-cli: runs the local Claude Code CLI headless with the account it is logged into
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT_MS=120000
# Vision provider for the design critique and the model that designs the MVP page (REV-137): anthropic | openai | claude-cli
# (empty = critique: Anthropic key, then OpenAI key, then the CLI when found; page: MVP_LLM_PROVIDER, then the first key, then the CLI)
VISION_LLM_PROVIDER=
# MVP completeness check (REV-37): the MVP_LLM_PROVIDER model judges the fields, with its quotes
# verified in code. false = code-only comparison. Falls back to code on timeout or error.
MVP_COMPLETENESS_LLM=true
MVP_COMPLETENESS_LLM_TIMEOUT_MS=90000

# Email Outreach: resend | sendgrid | smtp. With none, approved emails fail at dispatch and test sends
# answer 503 (nothing is faked). Read by both the workers and the API (REV-60)
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="Revamp Team <outreach@revampdemo.com>"

# Local Business Discovery (REV-26)
# OpenStreetMap works without a key; Google Places API (New) needs one
GOOGLE_PLACES_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
DISCOVERY_USER_AGENT="RevampBot/0.1 (+https://revampdemo.com)"
# Max provider requests per search when paging for more new businesses (each Google page is billed)
DISCOVERY_MAX_REQUESTS=5
# Pre-assessment of each new business's home page before import (REV-98): per-site timeout and parallel checks
DISCOVERY_ASSESS_TIMEOUT_MS=8000
DISCOVERY_ASSESS_CONCURRENCY=6

# Operator / HITL Settings
OPERATOR_NOTIFY_EMAIL=operator@revampdemo.com

# Frontend Dashboard
VITE_API_URL=http://localhost:4000/api/v1
