    <!-- MODULE 5: INTERACTIVE BOOKING FORM -->
    <section class="booking-section" id="booking">
      <div class="container">
        <div class="booking-wrapper">
          <div class="section-header" style="margin-bottom: 2rem;">
            <span class="section-tag">Kontakt</span>
            <h2 class="section-title" style="font-size: 1.75rem;">Wyślij zapytanie</h2>
            <p class="section-desc">
              Zostaw swoje dane, a Warsaw Dental Center skontaktuje się z Tobą.
            </p>
          </div>

          <form id="lead-booking-form" class="booking-form" novalidate>
            <div class="form-group">
              <label for="lead-name" class="form-label">Imię i nazwisko *</label>
              <input 
                type="text" 
                id="lead-name" 
                name="name" 
                class="form-input" 
                placeholder="Jan Kowalski" 
                required 
                autocomplete="name"
              />
            </div>

            <div class="form-group">
              <label for="lead-phone" class="form-label">Numer telefonu *</label>
              <input 
                type="tel" 
                id="lead-phone" 
                name="phone" 
                class="form-input" 
                placeholder="Twój numer telefonu" 
                required 
                autocomplete="tel"
              />
            </div>

            <div class="form-group">
              <label for="lead-service" class="form-label">Interesująca usługa</label>
              <select id="lead-service" name="service" class="form-select">
                <option value="Konsultacja ogólna">Konsultacja ogólna</option>
                <option value="Implanty">Implanty</option>
              </select>
            </div>

            <div class="form-group">
              <label for="lead-notes" class="form-label">Uwagi lub prośby</label>
              <textarea 
                id="lead-notes" 
                name="notes" 
                class="form-textarea" 
                placeholder="Dodaj szczegóły lub preferowany termin wizyty..."
              ></textarea>
            </div>

            <div class="form-checkbox-container">
              <input type="checkbox" id="policy-consent" class="form-checkbox" checked required />
              <label for="policy-consent" class="checkbox-label">
                Wyrażam zgodę na przetwarzanie moich danych osobowych i akceptuję politykę prywatności.
              </label>
            </div>

            <button type="submit" id="booking-submit-btn" class="form-submit-btn">
              <span>Umów się</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" />
    <path d="M22 2 11 13" /></svg>
            </button>
          </form>

          <!-- Confirmation State -->
          <div id="booking-success-message" class="form-success-message" aria-live="polite">
            <div class="success-icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
    <polyline points="22 4 12 14.01 9 11.01" /></svg>
            </div>
            <h3 class="success-title">Dziękujemy za kontakt!</h3>
            <p class="success-desc" id="success-client-info">
              Twoje zgłoszenie zostało przyjęte. Nasz specjalista wkrótce się z Tobą skontaktuje.
            </p>
            <button type="button" id="reset-form-btn" class="btn-secondary" style="margin-inline: auto;">
              Wyślij kolejne zgłoszenie
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>

