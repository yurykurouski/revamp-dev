    /* -------------------------------------------------------------
       MODULE 4: SOCIAL PROOF & REVIEWS
       ------------------------------------------------------------- */
    .reviews-section {
      padding-block: 4rem 3rem;
      background: linear-gradient(180deg, var(--color-bg-body) 0%, #f1f5f9 100%);
    }

    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
