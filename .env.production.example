# ==============================================================================
# Revamp SaaS - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production on your production server (VPS/Hetzner)
# and populate it with your production credentials.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & API Gateway
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed origins (e.g. Cloudflare Pages frontend & apex domain)
CORS_ORIGIN=https://app.revamp.io,https://revamp.io
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. Managed Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Production connection string with replica sets, TLS, and write concern
MONGODB_URI=mongodb+srv://revamp_app:<DB_PASSWORD>@revamp-prod-cluster.mongodb.net/revamp_prod?retryWrites=true&w=majority&appName=RevampProduction

# ------------------------------------------------------------------------------
# 3. Managed Message Broker (Upstash / Redis Cloud for BullMQ)
# ------------------------------------------------------------------------------
# Recommended: single TLS connection URI (rediss://)
REDIS_URL=rediss://default:<REDIS_PASSWORD>@<REGION>.upstash.io:6379
REDIS_TLS=true
# Fallback parameters if REDIS_URL is omitted:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Cloud Object Storage (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3: https://s3.<REGION>.amazonaws.com
S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=<CLOUDFLARE_R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<CLOUDFLARE_R2_SECRET_ACCESS_KEY>
S3_BUCKET_ASSETS=revamp-assets
S3_BUCKET_DEMOS=revamp-demos
# For Cloudflare R2 / AWS S3 virtual-hosted-style buckets, set to false
S3_FORCE_PATH_STYLE=false
# Custom domain connected to revamp-demos bucket for sandboxed preview iframe
PREVIEW_DOMAIN=preview.revamp.io

# ------------------------------------------------------------------------------
# 5. Production AI Models (Vision LLM & Copywriting)
# ------------------------------------------------------------------------------
# Primary multimodal model (Claude 3.5 Sonnet recommended for design critique)
ANTHROPIC_API_KEY=sk-ant-api03-...
# Backup / Alternative LLM provider (GPT-4o)
OPENAI_API_KEY=sk-proj-...
# Optional Gemini API key
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Production Email Outreach (Resend / SendGrid - HITL Gated)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
SENDGRID_API_KEY=
EMAIL_FROM="Revamp Team <outreach@revamp.io>"

# ------------------------------------------------------------------------------
# 7. Operator & Telemetry Settings
# ------------------------------------------------------------------------------
OPERATOR_NOTIFY_EMAIL=operator@revamp.io
TRACKING_BASE_URL=https://api.revamp.io/api/v1/track

# ------------------------------------------------------------------------------
# 8. Frontend Dashboard Environment
# ------------------------------------------------------------------------------
VITE_API_URL=https://api.revamp.io/api/v1
